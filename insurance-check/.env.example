# ─────────────────────────────────────────────────────────────
# 내보험 통합 점검 — 환경변수 예시
# 복사: cp .env.example .env.local   (.env*.local은 git에 올라가지 않음)
# 운영 필수 항목 목록: config/requirements.json  /  점검: npm run check:deploy
# ─────────────────────────────────────────────────────────────

# demo | staging | production
#  demo: 가짜 데이터·서버 메모리 저장·'데모' 표시. 실제 접수 아님.
#  staging: 실제 DB(Supabase)에 '테스트 신청'으로 저장·'테스트' 표시·광고 태그 없음. 인프라 + APPROVAL_DB_VERIFIED + DB 자동 점검 통과 시 접수.
#  production: 아래 운영 정보 + 인프라 + 승인 기록이 모두 있어야 신청 폼이 열리고 빌드가 통과한다.
APP_MODE=demo
# Vercel Preview 배포에서만 테스트 신청(staging)을 켜는 스위치. Production 배포에서는 값이 있어도 무시된다.
# Vercel 환경변수에서 Preview에만 1로 넣는다. (APP_MODE=staging도 Vercel Production 배포에서는 운영 기준으로 잠긴다)
PREVIEW_TEST_SUBMISSIONS=

# 세션·영수증 토큰 서명 키 (32자 이상, 랜덤). 생성: openssl rand -hex 32
APP_SECRET=
# 데모 관리자 비밀번호 (데모 모드 전용, 로컬에서만)
DEMO_ADMIN_PASSWORD=

# ── 인프라 (테스트·운영) ── 모두 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 말 것(빌드가 막는다).
NEXT_PUBLIC_SITE_URL=https://example.com
# Supabase → Project Settings → API: Project URL (https://<ref>.supabase.co)
SUPABASE_URL=
# 공개 키: publishable 키(sb_publishable_…) 또는 legacy anon 키. 서버의 관리자 로그인 확인에만 쓴다
SUPABASE_ANON_KEY=
# 🔴 비밀키: secret 키(sb_secret_…) 또는 legacy service_role 키. 서버 전용 — 공개 키를 넣으면 빌드가 막는다
SUPABASE_SERVICE_ROLE_KEY=
# 연락처 암호화 키: openssl rand -base64 32
PII_ENCRYPTION_KEY=
# 보유기간(신청일로부터 1년) 경과 자동 파기 Cron 호출 키 (운영 전용, 16자 이상). 생성: openssl rand -hex 32
#  Vercel Production에 넣으면 Vercel Cron(vercel.json, 매일 03:00 KST)이 Authorization 헤더로 보낸다. 비어 있으면 운영 접수가 잠긴다
CRON_SECRET=

# ── 운영 주체·고지 정보 (실제 값만 입력. 승인 전 가짜 값 금지) ──
OPERATOR_NAME=
OPERATOR_BIZ_NO=
AGENCY_NAME=
AGENCY_REG_NO=
PLANNER_NAME=
PLANNER_REG_NO=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_HOURS=평일 09:00-18:00
BUSINESS_ADDRESS=
PRIVACY_OFFICER=
# 개인정보 처리 주체 — 소속 GA 승인 사항에 따라 설정 (설계사 개인 / GA 법인 등)
PRIVACY_CONTROLLER=
COVERAGE_PROCESSOR=
# none 이면 "제3자에게 제공하지 않습니다". 제공 시 제공받는 자·목적·항목·보유기간을 문장으로 기재
THIRD_PARTY_PROVISION=
RETENTION_CLAIM=
RETENTION_COVERAGE=
AD_REVIEW_NO=
PRIVACY_POLICY_EFFECTIVE_DATE=
# 처리위탁·국외 이전 고지용 위치 — 대시보드에서 직접 확인한 값만 (추측 금지)
#  SERVER_REGION: Vercel → Project → Settings → Functions → Function Region (예: 미국 워싱턴 D.C.(iad1))
#  DB_REGION:     Supabase → Project Settings → General/Infrastructure → Region (예: 대한민국 서울(ap-northeast-2))
SERVER_REGION=
DB_REGION=

# ── 소속 GA 사전 승인 기록 (승인일 YYYY-MM-DD) ── 승인 전에는 비워둘 것
APPROVAL_AD_REVIEW=
APPROVAL_PRIVACY=
APPROVAL_COVERAGE_OFFER=
APPROVAL_THIRD_PARTY=
APPROVAL_STATS_VERIFIED=
# 운영 DB 점검 확인일: SQL Editor에서 supabase/verify.sql 점검표 1~14번이 모두 true인 것을 확인한 날 (테스트·운영 모드 필수)
APPROVAL_DB_VERIFIED=

# ── 선택 ──
# GA4 측정 ID (운영 모드 + 방문자 동의 시에만 로드)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# 담당자 알림 제공자 (승인된 제공자 어댑터 구현 전에는 비워둘 것 — 설정해도 발송하지 않음)
NOTIFY_PROVIDER=
