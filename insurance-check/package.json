{
  "name": "insurance-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "node scripts/check-deploy.mjs && next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:deployed": "E2E_BASE_URL=${E2E_BASE_URL:-https://insurance-check-demo.vercel.app} playwright test release-check",
    "check:deploy": "node scripts/check-deploy.mjs --strict",
    "setup:demo": "node scripts/setup-demo-env.mjs",
    "lint": "eslint app components lib tests scripts middleware.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "^15.5.28",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
